[Unit]
Description=Eicon PPP bundle member on ISDN 7940 (ttyds16)
Requires=divas4linux.service
After=divas4linux.service network.target
[Service]
ExecStartPre=/usr/bin/test -c /dev/ttyds16
ExecStart=/usr/sbin/pppd call eicon-7940-16
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
