[Unit]
StartLimitIntervalSec=0
Description=v90modem 10-line dial-in server (Asterisk 2951-2960, pilot 2950)
Documentation=file:///root/v90ras/rig/v90ras/README.md
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/v90ras/sip.env
# Halves PPP RTT against the 200 ms default (docs/eicon_mlppp_20261107.md).
Environment=ME_JB_MS=40
# Live A/B (2026-11-07): B1 rate drops by V.34 11.6 instead of a ~10 s 11.5
# retrain; the Win95 modems hang up ~55 s after answering.
Environment=ME_V34_B1_RENEG=1
# The engine default Ja fallback (500 ms) stays: real modems on the Cisco
# FXS (7800/7802) send a Ja we do not decode, and without the fallback they
# never got Sd (rig/v90ras/README.md, 2026-11-07).
# G.711 taps per call: %L is the line, %P the worker's PID (one worker per
# call under --recycle). Disposable; delete old calls/ entries by hand.
Environment=VPCM_G711_TAP_DIR=/var/tmp/v90ras/calls/line%%L-%%P
Environment=TMPDIR=/var/tmp/v90ras
RuntimeDirectory=v90ras
RuntimeDirectoryPreserve=yes
ExecStartPre=/bin/mkdir -p /var/tmp/v90ras/calls
ExecStart=/opt/v90ras/sip_v90_modem --lines 10 --recycle \
  --sip-server asterisk.net.cryan.nz \
  --username ${V90RAS_USERS} --password ${V90RAS_PASSWORDS} \
  --local-port 5300 --rtp-port 30000 --pty-link /run/v90ras/line --profile /etc/v90ras/profile
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
