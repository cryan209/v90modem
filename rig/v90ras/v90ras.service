[Unit]
StartLimitIntervalSec=0
Description=v90modem 10-line dial-in server (Asterisk 2951-2960, pilot 2950)
Documentation=file:///root/v90ras/rig/v90ras/README.md
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/v90ras/sip.env
# Halves PPP RTT against the 200 ms default (docs/eicon_mlppp_20261107.md).
Environment=ME_JB_MS=40
# Live A/B (2026-11-07): B1 rate drops by V.34 11.6 instead of a ~10 s 11.5
# retrain; the Win95 modems hang up ~55 s after answering.
Environment=ME_V34_B1_RENEG=1
# B1 stepped 21600 down at 25.2 dB (2026-11-07 21:47) and the 11.6 that did
# it left data white; the same modems ran 21600 clean at 23.8 dB (20:28,
# 0.045 from the grid).  3 dB of slack keeps the trained rate; a rate that is
# really too high still goes white and the data-loss path handles it.
Environment=ME_V34_B1_RATE_MARGIN_DB=3
# A retraining multilink member stalled the whole bundle (2026-11-07 19:23):
# past 10 s of data, hang the member up instead.
# ... but only while another line has a call: a lone link retrains.
Environment=ME_V34_LOSS_HANGUP_AFTER_MS=10000
Environment=ME_LINE_BUSY_DIR=/run/v90ras/busy
# Our V.34 receiver at 3429 baud drifts to white against these modems
# (2026-11-07 19:15, 7802: 21600 at 3429, B1 27.6 dB, data 0.43 -> white in
# 2 s, reproduced offline); every clean decode was at 3200. Our own probe
# rated 3429 worst (ripple 0.90 vs 0.29). Offer at most 3200.
Environment=ME_V34_BAUD=3200
# V.90 is offered again: only lines 8 and 9 (2959, 2960) have profile files,
# and those select x2 (rig/v90ras/v90ras-profile-x2); rig/v90ras/v90ras-profile is the
# plain-V.34 cap used 19:20-23:45 on 2026-11-07, no longer installed.  The Win95 modems' Ja never
# decoded because blind CMA walked our Phase 3 equalizer off during Ja; DD-LMS
# there decodes it on the recorded calls.  The engine default Ja fallback
# (500 ms) stays.
# V.90 9.3.1.6: repeat DIL until the analogue modem's S-to-S-bar.  The
# engine's default one-cycle cap (1.63 s here) sent Ri while the Win95 modem
# was still studying DIL; its 9.3.2.10 S came 14 s later and the CPt it built
# from our Ri had an empty interval-5 constellation, which we cannot map
# (2026-11-08, line0-1103132; replay with 0 detects that S and ends DIL on a
# segment boundary).
Environment=ME_V90_DIL_AUTOTERMINATE_CYCLES=0
# Hold the line echo canceller's delay tracker.  Behind the TopRouter the
# Cisco's playout is fixed (40 ms), so the echo path cannot move; but the
# tracker moved it +/-146-148 ms to a false peak and back, in pairs, right after
# DATA began, on both 2026-11-08 calls after 12:59 (line0-47498).  The V.90
# upstream then went 0.04 -> 0.31 from the grid in 64 symbols and we requested
# a 9.6 resync, or B1 never validated.  Replayed with the tracker held, that
# data period stays at 0.008 until the recording diverges.  What the tracker
# locks onto at ~250 ms is not yet known.
Environment=ME_LEC_NO_TRACK=1
# Answer an analogue-initiated V.90 9.6 rate renegotiation (9.6.1.2); off by
# default for V.90.  7800 sends S 28.6 s into every V.90 data period
# (line0-242133, symbol 90897); unanswered, our slip search took it for a
# timing step, framing was lost, and the modem retrained at 31.4 s.  A replay
# detects that S with no false detection in the 28 s before it.  Live A/B
# from 2026-11-08 18:5x (CT 117 drop-in v90-reneg-respond.conf).
Environment=ME_V90_RENEG_RESPOND=1
# G.711 taps per call: %L is the line, %P the worker's PID (one worker per
# call under --recycle). Disposable; delete old calls/ entries by hand.
Environment=VPCM_G711_TAP_DIR=/var/tmp/v90ras/calls/line%%L-%%P
# Diagnosis of V.42 across a retrain (2026-11-07 20:27: line 0 decoded clean
# after its retrain but no PPP frame arrived from the client again).
# Engine log ~2 lines/s; received bits as ASCII next to the taps.
Environment=VPCM_ME_VERBOSE=1
Environment=ME_RX_BIT_DUMP=/var/tmp/v90ras/calls/line%%L-%%P/rx-bits.txt
Environment=TMPDIR=/var/tmp/v90ras
RuntimeDirectory=v90ras
RuntimeDirectoryPreserve=yes
ExecStartPre=/bin/mkdir -p /var/tmp/v90ras/calls
ExecStart=/opt/v90ras/sip_v90_modem --lines 10 --recycle \
  --sip-server asterisk.net.cryan.nz \
  --username ${V90RAS_USERS} --password ${V90RAS_PASSWORDS} \
  --local-port 5300 --rtp-port 30000 --pty-link /run/v90ras/line --profile /etc/v90ras/profile
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
