# Slow tier: `make test-slow`.  Real-time engine runs that take 50-140 s each
# (they wait on the fax protocol, not on the CPU).  Measured 2026-10-10;
# the fax matrix was cut to four rows 2026-10-15.

# V.90 8.5.2/9.4.2.5: 20 s of exact upstream PRBS, both laws, 21600/26400,
# zero and +/-0.1 Hz carrier offsets. Carrier phase crosses full turns while
# the FSE adapts; no LAPM hides bit errors (docs/v90_upstream_data_path.md).
./v90_upstream_hold_test

@group fax-v34-test fax-v34-engine-test
# Full pages through two production engines.  One row per class and callback
# size, with law and paper alternated so each class still sees A4 and Letter,
# u-law and A-law, 80- and 160-sample callbacks.  The full 2x2x2x2 matrix (16
# rows, ~50 min of CPU) ran the same protocol path four times over: paper only
# changes the row count, and law and callback size are also covered per class
# by the --v34-class rows in fast.list.
FAX_TEST_PAGE=a4 ./fax_class2_test --engine-class1 ulaw 80
FAX_TEST_PAGE=letter ./fax_class2_test --engine-class1 alaw 160
FAX_TEST_PAGE=letter ./fax_class2_test --engine-class21 alaw 80
FAX_TEST_PAGE=a4 ./fax_class2_test --engine-class21 ulaw 160
@group
./console_test
# Filter with --group multi-line-sip; add -j1 for isolated harness runs.
@group multi-line-sip
# Multi-line server: four concurrent V.34 calls.
python3 tools/multi_line_test.py --lines 4 --mode v34 --connect-timeout 90
# V.90 8.5.2/9.4.2.5: eight independent bearer/engine processes, 32 exact
# payload blocks per call, then repeat on fresh workers after recycling.
python3 tools/multi_line_test.py --lines 8 --mode v90 --payload-rounds 32 --recycle --io-schedule
# Kill one active worker, redial its fresh replacement, and require untouched
# peers to finish their original exact payloads while it trains and reconnects.
python3 tools/multi_line_test.py --lines 3 --mode v90 --payload-rounds 64 --restart-line 0 --io-schedule
@group
# Our x2 analogue client against the original Ie030002 I-modem in a clean
# courier-emu export (../courier-emu), no ANSam knob: CONNECT and a line each way.
sh -c 'git -C ../courier-emu archive f1ccd92 | tar -x -C "$TMPDIR" && ln -s "$PWD/../courier-emu/Ie030002.nac" "$TMPDIR/" && env -u ME_ANS_NOTCH_RATIO ../courier-emu/.venv/bin/python tools/probe_x2_client_imodem.py --emu "$TMPDIR" --output "$TMPDIR/out" --fast --engine-at "AT\\N0" --engine-send OUR-X2-CLIENT-0123456789! --answer-send IMODEM-X2-SERVER-0123456789'
# The same client opens an in-data rate change to index 8 with LAPM up; the
# I-modem must complete it and both lines still arrive.
sh -c 'git -C ../courier-emu archive f1ccd92 | tar -x -C "$TMPDIR" && ln -s "$PWD/../courier-emu/Ie030002.nac" "$TMPDIR/" && ME_X2_CLIENT_RENEG_AFTER_MS=9000 ME_X2_CLIENT_RENEG_INDEX=8 ../courier-emu/.venv/bin/python tools/probe_x2_client_imodem.py --emu "$TMPDIR" --output "$TMPDIR/out" --fast --engine-at "AT&A3" --engine-send OUR-X2-CLIENT-0123456789! --answer-send IMODEM-X2-SERVER-0123456789 && grep -q "X2 client rate change complete: index=8" "$TMPDIR/out/engine.log"'
# The I-modem retrains (V.90 9.5.1.1, Tone B) after 500 ms without our
# upstream; the client answers (9.5.2.2), data resumes, and all ten of our
# lines reach its DTE with no NO CARRIER.
sh -c 'git -C ../courier-emu archive f1ccd92 | tar -x -C "$TMPDIR" && ln -s "$PWD/../courier-emu/Ie030002.nac" "$TMPDIR/" && ME_X2_CLIENT_SILENCE_AFTER_MS=6000 ME_X2_CLIENT_SILENCE_MS=500 ../courier-emu/.venv/bin/python tools/probe_x2_client_imodem.py --emu "$TMPDIR" --output "$TMPDIR/out" --fast --engine-at "AT&A3" --engine-send OUR-X2-CLIENT-0123456789! --answer-send IMODEM-X2-SERVER-0123456789 && grep -q "X2 client enter DATA: .*(after the server.s retrain)" "$TMPDIR/out/engine.log" && python3 -c "import json,sys; r=json.load(open(sys.argv[1])); t=\"\".join(s[\"text\"] for s in r[\"serial_session\"] if s[\"direction\"].startswith(\"received\")); sys.exit(0 if t.count(\"OUR-X2-CLIENT-0123456789!\")==10 and \"NO CARRIER\" not in t else 1)" "$TMPDIR/out/imodem-result.json"'
