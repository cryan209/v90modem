sh -c 'python3 tools/k56flex_hsf_pair.py --seconds 40 --payload-bytes 8192 --require-payload --require-audio-gates --output "$TMPDIR/hsf" > "$TMPDIR/hsf.log" 2>&1 || { tail -40 "$TMPDIR/hsf.log"; tail -60 "$TMPDIR/hsf/server.log"; exit 1; }'
# The same at 28800 up (HSF's ceiling raised from the harness's 9600).
sh -c 'python3 tools/k56flex_hsf_pair.py --max-upstream-rate 28800 --seconds 40 --payload-bytes 8192 --require-payload --require-audio-gates --output "$TMPDIR/hsf" > "$TMPDIR/hsf.log" 2>&1 && grep -q "28800 up / 52000 down" "$TMPDIR/hsf/server.log" || { tail -40 "$TMPDIR/hsf.log"; tail -60 "$TMPDIR/hsf/server.log"; exit 1; }'
