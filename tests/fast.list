# Fast tier: `make test-fast`.  Everything here finishes in seconds (longest
# ~20 s); the whole tier runs in parallel through tools/run_tests.py.
# One shell command per line, run from the repository root.  Comments
# above a row say why it is pinned or why a neighbouring row is absent.
# "@group a b" tags the rows that follow, until the next bare "@group", for
# `tools/run_tests.py --group a`; the per-area make targets use it.

# Retention: only indexed reference-data/ may be read; artifacts/ expires.
python3 tools/test_retention.py
python3 tools/check_reference_data.py
# Bounded stdout/stderr capture and test-runner status handling.
python3 tools/test_log_capture.py
# Allocation-free media callback latency histograms (no hardware dependency).
./media_perf_test
python3 tools/test_media_perf_report.py
# Bounded diagnostic writers: stalls/errors must never block or splice audio.
./async_capture_test
python3 tools/test_async_capture_engine.py

# MT5634MU diagnostic transport only; does not require or qualify hardware.
python3 tools/mt5634mu_diag_test.py

# Proprietary V.FC c749..c788 mapper, against original Courier firmware vectors.
# This qualifies symbol coding only, not training or a V.FC modem connection.
./vfc_mapper_test
./vfc_signature_test
./vfc_frame_test
./vfc_frame_codec_test
./vfc_trellis_test

./fax_v34_preamble_test
./legacy_pcm_decode_test
./x2_session_test
./x2_client_test
./x2_sym_test
# x2 analogue client dialling our x2 server, whole engines both ends: open
# rates (56000/31200), a downstream cap and an upstream-only cap.
./engine_pair_test --both-at 'AT+MS=X2' --expect X2 --seconds 25
./engine_pair_test --call-at 'AT+MS=X2,0,0,40000' --answer-at 'AT+MS=X2' --expect X2 --expect-connect 40000 --seconds 25
./engine_pair_test --call-at 'AT+MS=X2,0,0,9600,0,0' --answer-at 'AT+MS=X2' --expect X2 --seconds 25
# Our x2 server retrains when it loses our client's upstream (V.90 9.5.1.1,
# ME_X2_RETRAIN_ON_LOSS) and the client answers it; the V.42 payload must
# arrive intact both ways across the retrain.
./engine_pair_test --both-at 'AT+MS=X2' --call-env ME_X2_CLIENT_SILENCE_AFTER_MS=1000 --call-env ME_X2_CLIENT_SILENCE_MS=1500 --answer-env ME_X2_RETRAIN_ON_LOSS=1 --answer-log 'upstream=31200 (after a retrain)' --call-log '(after the server' --payload-printable RR --payload-reps 400 --expect X2 --seconds 60
# Our x2 client loses its downstream for 1 s and retrains (V.90 9.5.2.1,
# Tone A); our server answers it (9.5.1.2) and the V.42 payload arrives
# intact both ways across it.
./engine_pair_test --both-at 'AT+MS=X2' --call-env ME_X2_CLIENT_DEAF_AFTER_MS=1000 --call-env ME_X2_CLIENT_DEAF_MS=1000 --call-log '(after our retrain)' --answer-log 'answering the retrain (9.5.1.2)' --answer-log 'upstream=31200 (after a retrain)' --payload-printable RR --payload-reps 400 --expect X2 --seconds 60
# Our x2 client opens an in-data rate change (15 -> 6) mid-payload; both
# ends must complete it and the V.42 text must arrive intact both ways.
./engine_pair_test --both-at 'AT+MS=X2' --call-env ME_X2_CLIENT_RENEG_AFTER_MS=1000 --call-env ME_X2_CLIENT_RENEG_INDEX=6 --call-log 'X2 client rate change complete: index=6 downstream=44000' --answer-log 'X2 rate change complete: index=6' --payload-printable RR --payload-reps 128 --expect X2 --seconds 40
# The same over V.14 (no error control, 15 -> 1): no octet may be lost or
# added at the switch in either direction.
./engine_pair_test --both-at 'AT+MS=X2' --both-at AT+ES=1 --call-env ME_X2_CLIENT_RENEG_AFTER_MS=3100 --call-env ME_X2_CLIENT_RENEG_INDEX=1 --call-log 'X2 client rate change complete: index=1' --answer-log 'X2 rate change complete: index=1' --payload-printable RR --payload-reps 128 --hold-seconds 3 --expect X2 --seconds 40
./engine_pair_test --alaw --both-at 'AT+MS=K56' --expect-connect 52000 --both-expect 'CONNECT 52000' --payload-printable X --payload-reps 128 --seconds 60
./engine_pair_test --both-at 'AT+MS=K56' --both-at 'AT+ES=1' --expect-connect 52000 --seconds 45
./engine_pair_test --call-at 'AT+MS=V34' --answer-at 'AT+MS=K56' --expect V34 --seconds 40
./engine_pair_test --both-at 'AT+MS=K56' --call-env ME_K56FLEX_CLIENT_MP_DOWN_CODE=7 --expect-connect 44000 --both-expect 'CONNECT 44000' --payload-printable X --payload-reps 64 --seconds 50
