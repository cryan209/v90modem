# V.21 §§2–4, 7(a): complementary 300-bit/s FSK channels, async data.
./engine_pair_test --expect V21 --expect-connect 300 --both-env ME_DATA_FRAMING=v14 --both-at AT+MS=V21,0,300,300
# Bell 103: the same FSK path with 1070/1270 and 2025/2225 Hz, both laws.
./engine_pair_test --expect B103 --expect-connect 300 --both-env ME_DATA_FRAMING=v14 --both-at AT+MS=B103,0,300,300
./engine_pair_test --alaw --expect B103 --expect-connect 300 --both-env ME_DATA_FRAMING=v14 --both-at AT+MS=B103,0,300,300
