@group
# Foreign RASfinder S acquisition before our first divergent transmission.
python3 tools/test_v32bis_rasfinder_acquisition.py
./v32bis_spandsp_test
./v32bis_duplex_test
./v32bis_engine_pair_test ulaw v8
./v32bis_engine_pair_test alaw v8
./v32bis_engine_pair_test ulaw automode
./v32bis_engine_pair_test alaw automode
# The V.8 caller's CM without the V.32 bit: a different V.21 pattern for the
# answerer's V.22bis receiver to demodulate during Ta (V.32bis A.2.2), which
# must not reach the DTE (V.22bis 6.3.1.1.2 e).
ME_V8_ADVERTISE_V32=0 ./v32bis_engine_pair_test ulaw automode
ME_V8_ADVERTISE_V32=0 ./v32bis_engine_pair_test alaw automode
./v32bis_engine_pair_test ulaw aa
./v32bis_engine_pair_test alaw aa
# V.32bis clause 7: one engine initiates a retrain in data mode, the other
# must detect it from the far end's tone (7.1/7.2), and both re-run 6.1/6.2
# from the tone phases.  LAPM, because the responder's circuit 104 is clamped
# only on detection and V.42's FCS is what discards the bits before it.
PAIR_RETRAIN=call ME_DATA_FRAMING=lapm ./v32bis_engine_pair_test ulaw v8
PAIR_RETRAIN=answer ME_DATA_FRAMING=lapm ./v32bis_engine_pair_test alaw v8
./engine_pair_test --expect V32BIS --expect-connect 14400 --both-env ME_MODE=v32bis
# Our V.90 analogue role against our digital side, whole engines (docs/v90_analogue_role.md).
./engine_pair_test --expect V90 --call-expect "CONNECT 31200" --answer-expect "CONNECT 56000" --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0
./engine_pair_test --alaw --expect V90 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0
# Hardware-facing digital TX must complete B1d through me_tx_audio as well.
./engine_pair_test --expect V90 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --answer-env ENGINE_PEER_LINEAR_TX=1 --answer-env ENGINE_PEER_LINEAR_RX=1
./engine_pair_test --alaw --expect V90 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --answer-env ENGINE_PEER_LINEAR_TX=1 --answer-env ENGINE_PEER_LINEAR_RX=1
# 10 KB of back-to-back V.14 characters upstream, no V.42 to retransmit: the
# 31200 upstream takes a hard symbol error every few hundred mapping frames,
# and only the 16-state trellis's parity (V.34 9.6.3, V0 epoch tracked from
# the code itself) keeps them off the DTE (docs/v90_upstream_data_path.md).
./engine_pair_test --expect V90 --both-env ME_DATA_FRAMING=v14 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --payload-printable "line 6 " --payload-reps 100 --seconds 60 --answer-log "CONNECT deferred: upstream B1 not acquired"
./engine_pair_test --alaw --expect V90 --both-env ME_DATA_FRAMING=v14 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --payload-printable "line 6 " --payload-reps 100 --seconds 60 --answer-log "CONNECT deferred: upstream B1 not acquired"
# The same pair as V.92 with PCM upstream (+PIG=0): INFO0 bit 26/27, Table 18
# INFO1a, V.92 Phases 3-4, both B1s, payload both ways (docs/v92_full_startup.md).
# V.92 mode with +PIG=1 still sets the INFO0 bits and must fall back to V.90.
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-env ME_MODE=v92 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-expect "CONNECT 56000" --both-after ATI6 --both-expect "Modulation         V92"
./engine_pair_test --alaw --expect V90 --both-at "AT+PIG=0" --both-env ME_MODE=v92 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --both-after ATI6 --both-expect "Modulation         V92"
# The CPd carries V.92 6.4.2 precoder coefficients (default): our analogue
# modem precodes, our digital receives feed-forward only.  And without them.
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-env ME_MODE=v92 --both-env ME_V92_PRECODER=0 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-expect "CONNECT 56000" --answer-nolog "V.92 CPd precoder (6.4.2)" --answer-log "B1u locked by decoding" --both-after ATI6 --both-expect "Modulation         V92"
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-env ME_MODE=v92 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-expect "CONNECT 56000" --answer-log "V.92 CPd precoder (6.4.2)" --answer-log "B1u locked by decoding" --both-after ATI6 --both-expect "Modulation         V92"
./engine_pair_test --expect V90 --both-env ME_MODE=v92 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 31200" --both-after ATI6 --both-expect "Modulation         V90"

# V.92 9.4 short Phase 2: both INFO0s carry bits 26/27, the digital modem
# reverses Tone B first, the analogue modem answers 40 ms later and sends
# INFO1a; no probing, no INFO1d (docs/v92_quick_connect.md).
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=2" --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-expect "CONNECT 56000" --answer-log "V.92 9.4.1.1.4: Tone A reversal received" --call-log "V.92 9.4.2.1.4: sending INFO1a" --both-nolog "short Phase 2 abandoned" --both-after ATI6 --both-expect "Modulation         V92"
./engine_pair_test --alaw --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=2" --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-log "V.92 9.4.1.1.4: Tone A reversal received" --call-log "V.92 9.4.2.1.4: sending INFO1a" --both-nolog "short Phase 2 abandoned"
./engine_pair_test --expect V90 --both-at "AT+PQC=0" --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 31200" --answer-log "V.92 9.4.1.1.4: Tone A reversal received" --call-log "V.92 9.4.2.1.4: sending INFO1a" --both-nolog "short Phase 2 abandoned" --both-after ATI6 --both-expect "Modulation         V90"
# V.92 Quick Connect end to end, our analogue caller against our digital answerer:
# QC1a, QCA1d, QTS, ANSpcm, TONEq (9.2.1.1/9.2.1.3, 9.2.4), then short Phase 2.
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=0" --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-expect "CONNECT 56000" --answer-log "V.92 9.2.4.3: short Phase 1 complete" --call-log "V.92 9.2.1.3: short Phase 1 complete" --answer-log "V.92 9.4.1.1.4: Tone A reversal received" --both-nolog "short Phase 2 abandoned" --both-after ATI6 --both-expect "Modulation         V92"
./engine_pair_test --alaw --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=0" --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-log "V.92 9.2.4.3: short Phase 1 complete" --call-log "V.92 9.2.1.3: short Phase 1 complete" --both-nolog "short Phase 2 abandoned"
./engine_pair_test --expect V90 --both-at "AT+PQC=0" --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 31200" --answer-log "V.92 9.2.4.3: short Phase 1 complete" --call-log "V.92 9.2.1.3: short Phase 1 complete"
# Quick Connect started by V.8bis (9.2.1.2, 9.2.4.2): the answerer's CRe is answered by QC2a,
# that by QCA2d, then the same QTS/ANSpcm/TONEq as above.
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=0" --both-env ME_V8BIS=1 --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-expect "CONNECT 56000" --answer-log "V.92 9.2.4.2: QC2a" --call-log "V.92 9.2.1.2: QCA2d" --answer-log "V.92 9.2.4.3: short Phase 1 complete" --call-log "V.92 9.2.1.3: short Phase 1 complete" --both-nolog "short Phase 2 abandoned" --both-after ATI6 --both-expect "Modulation         V92"
./engine_pair_test --alaw --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=0" --both-env ME_V8BIS=1 --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-log "V.92 9.2.4.2: QC2a" --call-log "V.92 9.2.1.2: QCA2d" --both-nolog "short Phase 2 abandoned"
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=1" --both-env ME_V8BIS=1 --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-log "V.92 9.2.4.2: QC2a" --call-log "V.92 9.2.1.2: QCA2d" --both-nolog "short Phase 2 ("
# The caller offers QC2a to an answerer without Quick Connect: nothing answers it, the caller
# waits 1 s and answers the CRe after all, and V.8bis goes on as usual.
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --call-at "AT+PQC=1" --answer-at "AT+PQC=3" --both-env ME_V8BIS=1 --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --call-log "V.92 9.2.1.2: no QCA2d within 1 s" --both-nolog "short Phase 1 complete"
# ... and the other way round: a caller without it answers the CRe at once.
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --call-at "AT+PQC=3" --answer-at "AT+PQC=1" --both-env ME_V8BIS=1 --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --both-nolog "short Phase 1 complete"
# Both modems analogue (Figures 7 and 8): QCA1a / QCA2a, ANSam, TONEq, then plain V.34.
./engine_pair_test --expect V34 --both-at "AT+PQC=1" --seconds 60 --both-env ME_MODE=v92 --both-env ME_V90_ROLE=analogue --answer-log "V.92 9.2.3.4: short Phase 1 complete" --call-log "V.92 9.2.1.3: short Phase 1 complete" --answer-log "V.92 9.2.3.1: QC1a" --call-log "V.92 9.2.1.1: QCA1a"
./engine_pair_test --alaw --expect V34 --both-at "AT+PQC=1" --seconds 60 --both-env ME_MODE=v92 --both-env ME_V90_ROLE=analogue --answer-log "V.92 9.2.3.4: short Phase 1 complete" --call-log "V.92 9.2.1.3: short Phase 1 complete"
./engine_pair_test --expect V34 --both-at "AT+PQC=1" --both-env ME_V8BIS=1 --seconds 60 --both-env ME_MODE=v92 --both-env ME_V90_ROLE=analogue --answer-log "V.92 9.2.3.2: QC2a" --call-log "V.92 9.2.1.2: QCA2a" --answer-log "V.92 9.2.3.4: short Phase 1 complete" --call-log "V.92 9.2.1.3: short Phase 1 complete"
./engine_pair_test --expect V34 --call-at "AT+PQC=1" --answer-at "AT+PQC=3" --seconds 60 --both-env ME_MODE=v92 --both-env ME_V90_ROLE=analogue --both-nolog "short Phase 1 complete"
./engine_pair_test --expect V34 --call-at "AT+PQC=3" --answer-at "AT+PQC=1" --seconds 60 --both-env ME_MODE=v92 --both-env ME_V90_ROLE=analogue --both-nolog "short Phase 1 complete"
# A digital modem CALLING an analogue one (9.2.2, 9.2.3.1/.3): QC1d / QC2d, QCA1a / QCA2a with its UQTS,
# QTS, QTS\, ANSpcm, TONEq, then Phase 2 with our analogue-role answerer (g_v90a_answering).
./engine_pair_test --seconds 60 --expect V90 --both-at "AT+PIG=0" --call-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --both-at "AT+PQC=1" --both-env ME_MODE=v92 --answer-env ME_V90_ROLE=analogue --call-log "V.92 9.2.2.1: QCA1a" --answer-log "V.92 9.2.3.1: QC1d" --call-log "V.92 9.2.2.3: short Phase 1 complete" --answer-log "V.92 9.2.1.3: short Phase 1 complete"
./engine_pair_test --alaw --seconds 60 --expect V90 --both-at "AT+PIG=0" --call-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --both-at "AT+PQC=1" --both-env ME_MODE=v92 --answer-env ME_V90_ROLE=analogue --call-log "V.92 9.2.2.3: short Phase 1 complete" --answer-log "V.92 9.2.1.3: short Phase 1 complete"
./engine_pair_test --seconds 60 --expect V90 --both-at "AT+PIG=0" --call-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --both-at "AT+PQC=1" --both-env ME_MODE=v92 --answer-env ME_V90_ROLE=analogue --both-env ME_V8BIS=1 --call-log "V.92 9.2.2.2: QCA2a" --answer-log "V.92 9.2.3.2: QC2d" --call-log "V.92 9.2.2.3: short Phase 1 complete" --answer-log "V.92 9.2.1.3: short Phase 1 complete"
# Short Phase 1 alone (+PQC=1): the full Phase 2 follows it.
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=1" --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-log "V.92 9.2.4.3: short Phase 1 complete" --call-log "V.92 9.2.1.3: short Phase 1 complete" --both-nolog "short Phase 2 ("
# The caller offers Quick Connect to an answerer that has it off: QC1a is ignored, CM follows, V.8 runs.
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --call-at "AT+PQC=1" --answer-at "AT+PQC=3" --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --both-nolog "short Phase 1 complete"
# One end alone asking for it is not an agreement: the full Phase 2 runs.
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --answer-at "AT+PQC=2" --call-at "AT+PQC=3" --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --both-nolog "short Phase 2 ("
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --call-at "AT+PQC=2" --answer-at "AT+PQC=3" --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --both-nolog "short Phase 2 ("
# 9.4.1.2.2: the analogue modem never answers the reversal; both ends give up on
# the short procedure after their timers and the call completes on the full one.
./engine_pair_test --expect V90 --seconds 60 --both-at "AT+PIG=0" --both-at "AT+PQC=2" --both-env ME_MODE=v92 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-env V92_SHORT_TEST_NO_REPLY=1 --call-expect "CONNECT 48000" --call-log "short Phase 2 abandoned (no Tone B reversal)" --answer-log "short Phase 2 abandoned (no Tone A reversal)"
# A whole V.34 call through one slot of the channel bank (docs/v34_fdm.md).
# 33600 since the start profile became a ceiling (3429) and the probe picks; the
# answer side's TRN SNR sits on the 32 dB edge for 33600 (31200 with 11.3.1.1.3's wait).
./engine_pair_test --expect V34 --call-expect "CONNECT 33600" --answer-expect "CONNECT 31200" --both-env ME_MODE=v34 --fdm-slot 5
./engine_pair_test --expect V32BIS --expect-connect 9600 --both-at "AT+MS=V32"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-env ME_V8BIS=1 --both-env VPCM_ME_VERBOSE=1 --both-log "V.8bis complete" --both-log "MS mode" --both-nolog "ended without a mode"
./engine_pair_test --alaw --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-env ME_V8BIS=1 --both-env VPCM_ME_VERBOSE=1 --both-log "V.8bis complete" --both-nolog "ended without a mode"
./engine_pair_test --expect V32BIS --expect-connect 14400 --both-env ME_MODE=v32bis --both-env ME_V8BIS=1 --both-env VPCM_ME_VERBOSE=1 --both-log "V.8bis complete"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --answer-env ME_V8BIS=1 --answer-env VPCM_ME_VERBOSE=1 --answer-log "nothing heard inside the window"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --call-env ME_V8BIS=1 --call-env VPCM_ME_VERBOSE=1 --call-log "ANS/ANSam heard first"
# No datapump: the DS0 is the bit pipe (clear_channel.c), two whole engines.
./engine_pair_test --expect CLEAR --expect-connect 64000 --both-at "AT+MS=V120"
./engine_pair_test --expect CLEAR --expect-connect 64000 --both-at "AT+MS=V120" --both-env ME_V120_ACK=1
./engine_pair_test --expect CLEAR --expect-connect 64000 --both-at "AT+MS=V120" --both-env ME_V120_VERIFY=1
./engine_pair_test --expect CLEAR --expect-connect 64000 --both-at "AT+MS=V120" --both-env ME_V120_ACK=1 --both-env ME_V120_COMPRESS=1 --answer-after "ATI11" --answer-expect "V.42bis over V.120 P0 3 P1 1024 P2 32"
./engine_pair_test --expect CLEAR --expect-connect 64000 --both-at "AT+MS=V120" --both-env ME_V120_ACK=1 --call-env ME_V120_COMPRESS=1
./engine_pair_test --expect CLEAR --expect-connect 64000 --both-at "AT+MS=V120" --call-env ME_V120_VERIFY=1
# \B (Hayes/Courier break) through the PTY: sent by the caller, seen by the answerer's ATI11.
./engine_pair_test --expect CLEAR --expect-connect 64000 --both-at "AT+MS=V120" --call-after 'AT\B2' --answer-after "ATI11" --answer-expect "received 1"
./engine_pair_test --expect CLEAR --expect-connect 64000 --both-at "AT+MS=V120" --both-env ME_V120_ACK=1 --call-after 'AT\B2' --answer-after "ATI11" --answer-expect "received 1"
./engine_pair_test --expect CLEAR --expect-connect 9600 --both-at "AT+MS=V110,0,0,9600" --call-after 'AT\B2' --answer-after "ATI11" --answer-expect "received 1"
./engine_pair_test --expect CLEAR --expect-connect 64000 --both-at "AT+MS=CLEAR" --call-after 'AT\B2' --call-expect "ERROR"
./engine_pair_test --expect CLEAR --expect-connect 64000 --both-at "AT+MS=V120" --call-env ME_V120_ACK=1
./engine_pair_test --expect CLEAR --expect-connect 9600 --both-at "AT+MS=V110,0,0,9600"
./engine_pair_test --expect CLEAR --expect-connect 38400 --both-at "AT+MS=V110"
# Synchronous V.110 (ME_V110_SYNC=1): the DTE's octets are the D-bit stream.
./engine_pair_test --expect CLEAR --expect-connect 9600 --both-at "AT+MS=V110,0,0,9600" --both-env ME_V110_SYNC=1
./engine_pair_test --expect CLEAR --expect-connect 14400 --both-at "AT+MS=V110,0,0,14400" --both-env ME_V110_SYNC=1
./engine_pair_test --expect CLEAR --expect-connect 38400 --both-at "AT+MS=V110" --both-env ME_V110_SYNC=1
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-at "AT+MS=V22B"
./engine_pair_test --expect V32BIS --both-env ME_V8=0
# A V.22bis modem that does not do V.8 (ME_V8=0 with V.22 alone: V.25 ANS then
# USB1, V.22bis 6.3.1).  Before 2026-10-05 ME_V8=0 was honoured only with
# V.32bis on, so these rows ran V.8 at both ends.  Our V.8 caller takes USB1
# after V.32bis A.2.1.2's Tc (default mode) or at once (V.22 alone).
./engine_pair_test --expect V22BIS --expect-connect 2400 --answer-env ME_V8=0 --answer-env ME_MODE=v22
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --answer-env ME_V8=0
./engine_pair_test --alaw --expect V22BIS --expect-connect 2400 --answer-env ME_V8=0 --answer-env ME_MODE=v22
./engine_pair_test --expect V22BIS --expect-connect 2400 --call-env ME_V8=0 --call-env ME_MODE=v22
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_V8=0 --both-env ME_MODE=v22
# A V.32bis call modem without V.8 answers that plain ANS with AA and must
# then take USB1 (V.32bis A.2.1.3); needs SpanDSP's answerer not to restart
# its transmitter on the AA-driven carrier-detect flaps.
./engine_pair_test --expect V22BIS --expect-connect 2400 --call-env ME_V8=0 --answer-env ME_V8=0 --answer-env ME_MODE=v22
./engine_pair_test --alaw --expect V22BIS --expect-connect 2400 --call-env ME_V8=0 --answer-env ME_V8=0 --answer-env ME_MODE=v22
# The same answerer with V.22bis 2.1's 1800 Hz guard tone (ME_V22_GUARD): our
# USB1 detector must leave it out of the denominator.
./engine_pair_test --expect V22BIS --expect-connect 2400 --answer-env ME_V8=0 --answer-env ME_MODE=v22 --answer-env ME_V22_GUARD=1800
# V.22 (AT+MS=V22, or V22B with a 1200 maximum: the datapump held at 1200, no
# S1) against V.22 and against a V.22bis peer in each role, which must settle
# at 1200 (V.22bis 6.3.1.1.1/6.3.1.2.1).
./engine_pair_test --expect V22BIS --expect-connect 1200 --both-at "AT+MS=V22"
./engine_pair_test --expect V22BIS --expect-connect 1200 --call-at "AT+MS=V22" --answer-env ME_MODE=v22
./engine_pair_test --alaw --expect V22BIS --expect-connect 1200 --call-env ME_MODE=v22 --answer-at "AT+MS=V22B,1,0,1200"
./engine_pair_test --expect V22BIS --expect-connect 1200 --call-env ME_V8=0 --call-env ME_MODE=v22-1200
# V.250 +MR/+ES/+ER/+DS/+DR against what two whole engines actually negotiate:
# the reports are in order (+MCR, +MRR, +ER, +DR, then CONNECT) and read the
# settled outcome, and the settings change the wire -- compression direction and
# off, error control off, the fallback when no V.42 peer answers detection, and
# "required" ending the call with NO CARRIER.
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --both-expect "+MCR: V22B|+MRR: 2400|+ER: LAPM|+DR: V42B|CONNECT 2400"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --alaw --both-expect "+MCR: V22B|+MRR: 2400|+ER: LAPM|+DR: V42B|CONNECT 2400"
./engine_pair_test --expect V22BIS --expect-connect 1200 --both-at "AT+MS=V22" --both-at "AT+MR=1" --both-expect "+MCR: V22|+MRR: 1200|CONNECT 1200"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT&A3" --both-at "AT&M4" --both-expect "CONNECT 2400/ARQ/V22B/LAPM/V42BIS"
# V.250 6.3.12 (S10) carrier loss in data, MNP at V.22bis 2400 as the CX93001
# dials us (docs/carrier_loss.md): a 40 ms drop into the answerer (long
# enough to trip carrier detect, ~30 ms) is held through without a retrain
# and costs the caller resent LTs, which MNP recovers; a 2 s drop hangs up
# at S10 = 1.4 s.  60.75 ms holds an odd number of T/2 instants: a hold that
# loses baud_phase parity fails it (60.625-60.875 ms), as a 60 ms RTP loss
# did on a live CX call; the 40 ms row passes either way.
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-at "AT+MS=V22B" --call-at "AT+ES=4,4" --both-at "AT&A3" --both-expect "/ARQ/V22B/MNP" --payload-printable X --payload-reps 16 --gap-ms 40 --gap-after-ms 1500 --answer-log "carrier back after" --answer-nolog "retrained in data" --call-after ATI11 --call-absent "(resent 0)" --seconds 60
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-at "AT+MS=V22B" --call-at "AT+ES=4,4" --both-at "AT&A3" --both-expect "/ARQ/V22B/MNP" --payload-printable X --payload-reps 16 --gap-ms 60.75 --gap-after-ms 1500 --answer-log "carrier back after" --answer-nolog "retrained in data" --seconds 60
./engine_pair_test --expect V22BIS --both-at "AT+MS=V22B" --call-at "AT+ES=4,4" --both-at "AT&A3" --answer-expect "/ARQ/V22B/MNP|NO CARRIER" --payload-printable X --payload-reps 16 --gap-ms 2000 --gap-after-ms 1500 --expect-hangup --gap-hangup-s 1.3 1.6 --answer-log "(S10), hanging up" --seconds 40
./engine_pair_test --expect V32BIS --expect-connect 9600 --both-env ME_MODE=v32bis --call-at "AT+MS=V32B,1,0,9600"
./engine_pair_test --expect V22BIS --call-at "AT+MS=V22B,1,2400" --answer-env ME_MODE=v22-1200 --expect-hangup --call-absent CONNECT --call-expect "NO CARRIER"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --both-at "AT+DS=0" --both-expect "+ER: LAPM|+DR: NONE|CONNECT"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --call-at "AT+DS=1" --call-expect "+DR: V42B TD|CONNECT" --answer-expect "+DR: V42B RD|CONNECT"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --call-at "AT+DS=2" --call-expect "+DR: V42B RD|CONNECT" --answer-expect "+DR: V42B TD|CONNECT"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --both-at "AT+ES=1,0,1" --both-expect "+ER: NONE|+DR: NONE|CONNECT"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --answer-at "AT+ES=,,1" --both-expect "+ER: NONE|+DR: NONE|CONNECT"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --answer-at "AT+DS=0" --call-at "AT+DS=3,0" --both-expect "+ER: LAPM|+DR: NONE|CONNECT"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --answer-env ME_DATA_FRAMING=v14 --seconds 60 --both-expect "+ER: NONE|+DR: NONE|CONNECT"
./engine_pair_test --expect-hangup --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --seconds 60 --answer-env ME_DATA_FRAMING=v14 --call-at "AT+ES=3,2" --call-absent CONNECT --call-expect "NO CARRIER"
./engine_pair_test --expect-hangup --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --seconds 60 --answer-env ME_DATA_FRAMING=v14 --call-at "AT+ES=3,3" --call-absent CONNECT --call-expect "NO CARRIER"
./engine_pair_test --expect-hangup --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --seconds 60 --call-env ME_DATA_FRAMING=v14 --answer-at "AT+ES=,,4" --answer-absent CONNECT --answer-expect "NO CARRIER"
./engine_pair_test --expect-hangup --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --seconds 60 --call-at "AT+ES=1,0,2" --answer-at "AT+ES=,,5" --answer-absent CONNECT --answer-expect "NO CARRIER"
./engine_pair_test --expect-hangup --both-env ME_MODE=v22 --both-at "AT+MR=1" --both-at "AT+ER=1" --both-at "AT+DR=1" --seconds 60 --answer-at "AT+DS=0" --call-at "AT+DS=3,1" --call-absent CONNECT --call-expect "NO CARRIER"
# ATI6/ATI11 read back what two whole engines are doing, live mid-call (after
# a guarded +++), ATY11 shows the line spectrum, and ATI6 names the modem as
# the end that gave up on a call
# whose required error control was not met.
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-after ATI6 --both-after ATI11 --both-after ATY11 --call-expect "CONNECT 2400|Originate, in progress|Modulation         V22B|Rate               2400|V.42 LAPM|Line level now     RX|Extended Link Diagnostics (live)|Mode               v22 (offer V22)|Role               caller|Line Spectrum|  1200|  2400|Total  Rx" --answer-expect "CONNECT 2400|Answer, in progress|V.42bis TX RX|Role               answerer"
# +DS44 (6.6.2): V.44 offered with V.42bis, the responder choosing; either end
# without V.44 falls back to V.42bis, directions intersect, and "required"
# ends a call that did not get V.44.
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+DR=1" --both-at "AT+DS44=3" --both-expect "+DR: V44|CONNECT 2400"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+DR=1" --call-at "AT+DS44=3" --both-expect "+DR: V42B|CONNECT 2400"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+DR=1" --answer-at "AT+DS44=3" --both-expect "+DR: V42B|CONNECT 2400"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+DR=1" --call-at "AT+DS44=1" --answer-at "AT+DS44=2" --call-expect "+DR: V44 TD|CONNECT" --answer-expect "+DR: V44 RD|CONNECT"
./engine_pair_test --expect-hangup --both-env ME_MODE=v22 --seconds 60 --call-at "AT+DS44=3,1" --call-absent CONNECT --call-expect "NO CARRIER"
# +EWIND/+EFRAM reach XID, and V.42 9.2.3/9.2.4's negotiation holds: each end
# takes the far end's "transmit" as its own receive (Table 11 Note 2), the
# responder chooses between the initiator's value and the default, and the
# link then runs on the agreed values (it used to fall back to its own).
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --both-at "AT+EWIND=4" --both-at "AT+EFRAM=64,32" --both-after ATI11 --both-expect "LAPM window        TX 4  RX 4|LAPM frame size    TX 64  RX 64"
./engine_pair_test --expect V22BIS --expect-connect 2400 --both-env ME_MODE=v22 --call-at "AT+EWIND=8" --answer-at "AT+EWIND=4" --both-after ATI11 --both-expect "LAPM window        TX 8  RX 8"
./engine_pair_test --expect-hangup --both-env ME_MODE=v22 --seconds 60 --answer-env ME_DATA_FRAMING=v14 --call-at "AT+ES=3,2" --call-absent CONNECT --call-after ATI6 --call-expect "NO CARRIER|Originate, failed before data mode|Modem (protocol or training failure)"
