./engine_pair_test --alaw --expect V22BIS --expect-connect 1200 --both-env ME_DATA_FRAMING=v14 --both-at AT+MS=B212,0,1200,1200
# A 212A caller must not train on a Bell 103 answerer's 2225 Hz mark; a 212A
# answerer falls back to Bell 103 for a 103 caller.
./engine_pair_test --seconds 15 --expect-no-connect --both-env ME_DATA_FRAMING=v14 --call-at AT+MS=B212,0,1200,1200 --answer-at AT+MS=B103,0,300,300
