./engine_pair_test --alaw --seconds 45 --expect-no-connect --both-env ME_MODE=v90 --both-env VPCM_ME_VERBOSE=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --answer-env ME_V90_UPSTREAM_T2=1 --answer-log "upstream measurement unavailable; no MP rate offered" --answer-nolog "Phase 4: MP"
./engine_pair_test --alaw --seconds 60 --expect V90 --both-env ME_MODE=v90 --both-env VPCM_ME_VERBOSE=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-at "AT+MS=V90,1,24000,24000,28000,56000" --answer-log "RX rate negotiated from CP/MP: 24000 bps" --call-log "rate mask 0x0100"
./engine_pair_test --seconds 45 --expect-no-connect --both-env ME_MODE=v90 --both-env VPCM_ME_VERBOSE=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-at "AT+MS=V90,1,24000,31200,28000,56000" --answer-at "AT+MS=V90,1,28000,56000,4800,21600" --answer-log "has no rate within" --answer-nolog "Phase 4: MP"
sh -c 'F=reference-data/artifacts/cx93001-ja-crc-fails-20261023/live-rx.g711; ME_MODE=v90 ./v90_engine_replay $F ulaw --fast --sync --sip-answer > "$TMPDIR/jat.log" 2>&1; grep -q "Ja recognised by template" "$TMPDIR/jat.log" && ME_V90_JA_TEMPLATE=0 ME_MODE=v90 ./v90_engine_replay $F ulaw --fast --sync --sip-answer > "$TMPDIR/jat0.log" 2>&1; ! grep -q "Ja recognised by template" "$TMPDIR/jat0.log"'

