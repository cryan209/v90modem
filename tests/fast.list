# A digital answerer taking the analogue role on QC1d / QC2d (9.2.4.1, 9.2.4.2): two default-role engines.
./engine_pair_test --seconds 60 --expect V90 --both-at "AT+PIG=0" --call-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --both-at "AT+PQC=1" --both-env ME_MODE=v92 --both-env ME_V8BIS=0 --call-log "V.92 9.2.2.1: QCA1a" --answer-log "V.92 9.2.3.1: QC1d" --answer-log "V.92 9.2.1.3: short Phase 1 complete" --call-log "V.92 9.2.2.3: short Phase 1 complete"
./engine_pair_test --seconds 60 --expect V90 --both-at "AT+PIG=0" --call-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --both-at "AT+PQC=1" --both-env ME_MODE=v92 --both-env ME_V8BIS=1 --call-log "V.92 9.2.2.2: QCA2a" --answer-log "V.92 9.2.3.2: QC2d" --answer-log "V.92 9.2.1.3: short Phase 1 complete" --call-log "V.92 9.2.2.3: short Phase 1 complete"
# V.92 9.2.5 / 9.3.1 ODP/ADP bypass: both ends signal LAPM, +PQC enabled -> no detection phase; factory +PQC=3 keeps it.
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=0" --both-env ME_MODE=v92 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-expect "CONNECT 56000" --both-log "ODP/ADP bypassed" --both-log "V.42 LAPM connected"
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=2" --both-env ME_MODE=v92 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --both-log "ODP/ADP bypassed" --both-log "V.42 LAPM connected"
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-env ME_MODE=v92 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --both-nolog "ODP/ADP bypassed" --both-log "V.42 LAPM connected"
# V.92 9.4.1.2.1 / 9.4.2.2.1: INFO0 recovery (INFO0d repeated with bit 28) still ends in the short Phase 2.
./engine_pair_test --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=0" --both-env ME_MODE=v92 --both-env V92_SHORT_TEST_INFO0_RECOVERY=1 --both-env ME_V34_SPAN_FLOW_LOG=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 48000" --answer-log "9.4.1.2.1 (test)" --answer-log "9.4.1.1.3: Tone A detected" --both-nolog "short Phase 2 abandoned"

./engine_pair_test --seconds 60 --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=0" --both-env ME_MODE=v92 --answer-env ME_V90_ROLE=analogue --call-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 56000" --answer-expect "CONNECT 48000" --call-log "V.92 9.2.2.3: short Phase 1 complete" --both-nolog "short Phase 2 abandoned"
./engine_pair_test --seconds 60 --expect V90 --both-at "AT+PIG=0" --both-at "AT+PQC=0" --both-env ME_MODE=v92 --both-env ME_V8BIS=1 --call-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 56000" --answer-expect "CONNECT 48000" --answer-log "V.92 9.2.3.2: QC2d" --both-nolog "short Phase 2 abandoned"
# The analogue role answering a plain V.8 call (no Quick Connect): Phase 2 is the analogue modem's whoever dialled.
./engine_pair_test --seconds 60 --expect V90 --both-at "AT+PIG=0" --both-env ME_MODE=v92 --answer-env ME_V90_ROLE=analogue --call-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 56000" --answer-expect "CONNECT 48000"
./engine_pair_test --seconds 60 --expect V90 --both-env ME_MODE=v90 --answer-env ME_V90_ROLE=analogue --call-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --call-expect "CONNECT 56000" --answer-expect "CONNECT 31200"
./engine_pair_test --alaw --seconds 60 --expect V90 --both-at "AT+PIG=0" --both-env ME_MODE=v92 --answer-env ME_V90_ROLE=analogue --call-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0
# The RasFinder's MT5634SMI does not reset its scrambler before V.90 B1 (10.1.3.1/V.34), so no B1 template fits;
# the upstream trains on the 4-point CP'/E instead and must decode B1 as scrambled ones (docs/v90_rasfinder_phase4.md).
# 3429/33600 from the MT5634SMI: its B1 runs the 8.2 switching pattern one mapping
# frame ahead (v34_rx_b1_search()); found at +8, state 13, where 0.24 was the best before.
# V.34 11.5.1.1/11.8.1: the 7910 never received our Phase 3 J and restarted Phase 2 with one INFO0a
# (DPSK, 2400 Hz) 3.2 s later; our caller sat in PHASE3_WAIT_S until it hung up.  macOS only (CoreAudio).
sh -c '[ "$(uname -s)" != Darwin ] || ./apple_usb_modem_coupler --rx-replay reference-data/artifacts/apple-7910-v34-info0a-after-j/rx.s16 2>&1 | grep -q "peer retrain tone detected; responding per 11.5"'
sh -c 'V34_CALL_P3_S_DELAY_MS=0 ./v90_engine_replay reference-data/artifacts/rf-mt5634-v34-3429-swp/live-rx.g711 ulaw --fast --dial --at "AT+MS=V34,0" 2>&1 | grep -q "B1 found 8 symbols after the E detection, far-end trellis state 13 (normalized correlation 1.000"'
sh -c 'ME_V90_UPSTREAM_MAX_BPS=9600 ./v90_engine_replay reference-data/artifacts/rf-mt5634-v90-b1/live-rx.g711 ulaw --fast --dial 2>&1 | grep -q "upstream DATA bits: t=0.1s tap=4 ones=100%"'
# V.90 9.2.1.1.6: our Tone B reversal waits for the CX93001's Tone A reversal.  With the RX clock frozen at 0 the
# 9.2.1.2.4 deadline read as expired and we reversed after 2 bauds, into the peer's L2 (docs/v90_hardware_interop.md).
sh -c 'ME_MODE=v90 ME_V34_SPAN_FLOW_LOG=1 ./v90_engine_replay reference-data/artifacts/cx93001-v90-phase2/live-rx.g711 ulaw --fast --sync --sip-answer > "$TMPDIR/p2.log" 2>&1; grep -q "Tone A reversal transaction completed at SECOND_B" "$TMPDIR/p2.log" && ! grep -q "recovery deadline reached at SECOND_B" "$TMPDIR/p2.log"'

@group
