./engine_pair_test --seconds 40 --expect V23 --both-env ME_DATA_FRAMING=v14 --payload-lines 2 --both-at AT+MS=V23C,0 --both-after ATI6 --call-expect "Rate               TX 75  RX 1200" --answer-expect "Rate               TX 1200  RX 75"
./engine_pair_test --alaw --seconds 40 --expect V23 --both-env ME_DATA_FRAMING=v14 --payload-lines 2 --both-at AT+MS=V23C,0
./engine_pair_test --seconds 40 --expect V23 --both-env ME_DATA_FRAMING=v14 --payload-lines 2 --call-at AT+MS=V23C,0,1200,1200,75,75 --answer-at AT+MS=V23C,0,75,75,1200,1200 --call-expect "CONNECT 75" --answer-expect "CONNECT 1200"
./engine_pair_test --seconds 10 --expect-no-connect --both-env ME_DATA_FRAMING=v14 --both-at AT+MS=V23C,0,1200,1200,75,75
# Legacy automode (docs/legacy_automode.md).  Answer side: our default
