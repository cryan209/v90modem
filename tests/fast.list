# the T/3 measurement deliberately; neither engine may CONNECT in that case.
./engine_pair_test --seconds 45 --expect-no-connect --both-env ME_MODE=v90 --both-env VPCM_ME_VERBOSE=1 --call-env ME_V90_ROLE=analogue --answer-env ME_V90_JA_HEURISTIC_FALLBACK_MS=0 --answer-env ME_V90_UPSTREAM_T2=1 --answer-log "upstream measurement unavailable; no MP rate offered" --answer-nolog "Phase 4: MP"
