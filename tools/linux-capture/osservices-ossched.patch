+/*
+ * OSSCHED is 8*sizeof(void*) = 64 bytes on x86_64 and the blob embeds it in its
+ * own structures, so it CANNOT be enlarged -- which is exactly what the
+ * sizeof() guard further down this file is protecting.  On 3.13 a
+ * struct kthread_work plus the two function-pointer fields is 72 bytes, so the
+ * >=3.8 path does not fit and the module refuses to load with
+ * "OSSCHED too small (64 < 72)".
+ *
+ * Store a POINTER to a separately allocated kwork_data instead.  The storage
+ * the blob owns then holds 8 bytes, well inside 64, and nothing about its
+ * layout changes.  There is no matching teardown hook in this API, so the
+ * allocation is not freed; that is acceptable for a driver instance that lives
+ * as long as the module.
+ */
+struct kwork_box { struct kwork_data *w; };
 
 __shimcall__
