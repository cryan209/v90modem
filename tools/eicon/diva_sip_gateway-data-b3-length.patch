@@ -103,7 +103,11 @@
 
 
 def data_b3_req(ncci: int, data: bytes, handle: int) -> bytes:
-    return struct.pack('<IIHHH', ncci, 0, len(data), handle, 0) + data
+    """DATA_B3_REQ parameters only: the data follows the message, outside its
+    length (CAPI 2.0 Part I 5.20; divacapi checks Data_Length against what was
+    written beyond the header length). Counting the data in the length made
+    every write fail with EIO, so no SIP audio ever reached the B channel."""
+    return struct.pack('<IIHHH', ncci, 0, len(data), handle, 0)
 
 
 class Reader:
