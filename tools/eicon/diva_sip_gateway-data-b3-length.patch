+             data: bytes = b'') -> int:
         if number is None:
             number = next(self.numbers) & 0x7FFF
-        os.write(self.fd, capi_message(self.appl, command, sub, number, body))
+        os.write(self.fd, capi_message(self.appl, command, sub, number, body) + data)
         return number
 
     def receive(self) -> CapiMessage | None:
